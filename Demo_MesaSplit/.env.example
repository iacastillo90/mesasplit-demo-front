# Configuración de entorno para la demo de MesaSplit.
# Copia este archivo a `.env` si necesitás sobreescribir valores en local.
# VITE_DEMO_MODE: Escenario A = demo en un solo dispositivo (pantalla dividida)
# vía BroadcastChannel, sin backend. Escenario B (cross-device) queda para futuro.
VITE_DEMO_MODE=same-device