# Configuración de entorno para la demo de MesaSplit.
# Copia este archivo a `.env` si necesitás sobreescribir valores en local.

# Modo de datos:
#   same-device = demo sin backend (BroadcastChannel + mocks)
#   backend     = conectado al backend LabTab (httpClient + JWT)
VITE_DEMO_MODE=same-device

# URL base del backend LabTab (Spring Boot).
VITE_API_URL=http://localhost:8080
